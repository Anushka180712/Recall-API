{
  "manifest_version": 3,
  "name": "Recall – Already Asked That?",
  "short_name": "Recall",
  "version": "1.0.0",
  "description": "Spots when you're about to ask ChatGPT something you already asked, and takes you back to that chat. Plus one-click cleanup of stale chats.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Recall",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/lib/umd.js",
        "src/lib/text.js",
        "src/lib/similarity.js",
        "src/lib/policy.js",
        "src/lib/historyIndex.js",
        "src/lib/cleanup.js",
        "src/lib/settings.js",
        "src/lib/routes.js",
        "src/lib/chatgptApi.js",
        "src/lib/store.js",
        "src/content/dom.js",
        "src/content/overlay.js",
        "src/content/content.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "110"
}
