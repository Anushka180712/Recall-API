{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Recall",
  "version": "1.1.0",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Recall",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/lib/umd.js",
        "src/lib/i18n.js",
        "src/lib/log.js",
        "src/lib/text.js",
        "src/lib/similarity.js",
        "src/lib/jump.js",
        "src/lib/policy.js",
        "src/lib/historyIndex.js",
        "src/lib/cleanup.js",
        "src/lib/settings.js",
        "src/lib/routes.js",
        "src/lib/chatgptApi.js",
        "src/lib/store.js",
        "src/content/dom.js",
        "src/content/overlay.js",
        "src/content/content.js"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "src/content/page-hook.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "111",
  "default_locale": "en",
  "options_ui": {
    "page": "src/popup/popup.html?options=1",
    "open_in_tab": true
  },
  "commands": {
    "toggle-recall": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "__MSG_shortcutDesc__"
    }
  }
}
